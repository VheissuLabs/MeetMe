APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev logs mail to storage/logs. Production sends recap + auth mail
# through Bento: set MAIL_MAILER=bento and the BENTO_* keys below, plus a
# MAIL_FROM_ADDRESS on your Bento-verified domain. (The bento mailer is
# registered automatically by bentonow/bento-laravel-sdk.)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@meetme.vheissulabs.com"
MAIL_FROM_NAME="MeetMe"

# Bento (email). From your Bento account: Settings → API keys / site UUID.
# Verify your sending domain in Bento before going live.
BENTO_PUBLISHABLE_KEY=
BENTO_SECRET_KEY=
BENTO_SITE_UUID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (realtime). On Laravel Cloud these are injected by the WebSocket cluster.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# GitHub OAuth app (Settings → Developer settings). Callback: {APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# X OAuth 2.0 app (developer.x.com). Callback: {APP_URL}/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Bluesky (AT Protocol OAuth). Generate the key with `php artisan bluesky:new-private-key`.
BLUESKY_OAUTH_PRIVATE_KEY=
# Local dev: leave CLIENT_ID/REDIRECT unset and run via http://127.0.0.1:8000 (Bluesky's
# localhost dev mode). Production needs a public domain — the package hosts the metadata:
# BLUESKY_CLIENT_ID=https://meetme.vheissulabs.com/bluesky/oauth/client-metadata.json
# BLUESKY_REDIRECT=https://meetme.vheissulabs.com/auth/bluesky/callback

# MeetMe is event-agnostic: configure your conference here, not in code.
MEETME_CONFERENCE_NAME="Laracon"
# Event dates (ISO 8601). Drive recap-email scheduling and answer retention.
# MEETME_STARTS_AT=2026-07-29
# MEETME_ENDS_AT=2026-07-30
# Size of the shared icebreaker pool built by `php artisan meetme:generate-questions`.
# Generation needs ANTHROPIC_API_KEY; the app itself runs fine without one (config fallback pool).
MEETME_QUESTION_COUNT=50
# ANTHROPIC_API_KEY=
# Max meeting-creation attempts per user per minute.
MEETME_SCAN_RATE_LIMIT=10

# Wallet passes (Apple/Google) — off until credentials below are configured.
MEETME_WALLET_PASS_ENABLED=false
# Apple Wallet (Apple Developer → Pass Type ID cert + Team ID):
# MOBILE_PASS_APPLE_ORGANIZATION_NAME="MeetMe"
# MOBILE_PASS_APPLE_TYPE_IDENTIFIER=pass.com.vheissulabs.meetme
# MOBILE_PASS_APPLE_TEAM_IDENTIFIER=
# MOBILE_PASS_APPLE_CERTIFICATE=        # base64 .p12, or use _PATH
# MOBILE_PASS_APPLE_CERTIFICATE_PASSWORD=
# Google Wallet (Google Cloud service account + Wallet issuer ID):
# MOBILE_PASS_GOOGLE_ISSUER_ID=
# MOBILE_PASS_GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
# Hard-delete answer text N days after MEETME_ENDS_AT. Unset keeps forever.
# MEETME_PURGE_ANSWERS_AFTER_DAYS=30
